<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/assign/submission/vidtreo/db" VERSION="20260323" COMMENT="XMLDB file for Moodle mod/assign/submission/vidtreo">
  <TABLES>
    <TABLE NAME="assignsubmission_vidtreo" COMMENT="Stores video recording submission data for VIDTREO Recorder">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="Primary key" />
        <FIELD NAME="assignment" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Foreign key to assign.id" />
        <FIELD NAME="submission" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Foreign key to assign_submission.id" />
        <FIELD NAME="recording_id" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Vidtreo recording ID" />
        <FIELD NAME="public_id" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Vidtreo public ID for video streaming" />
        <FIELD NAME="duration" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Video duration in seconds" />
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="Recording status: recording, uploading, complete, error" />
        <FIELD NAME="metadata" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON metadata blob containing user agent, source type, and other context" />
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" COMMENT="Primary key" />
        <KEY NAME="assignment_fk" TYPE="foreign" FIELDS="assignment" REFTABLE="assign" REFFIELDS="id" COMMENT="Foreign key to assign" />
        <KEY NAME="submission_fk" TYPE="foreign" FIELDS="submission" REFTABLE="assign_submission" REFFIELDS="id" COMMENT="Foreign key to assign_submission" />
      </KEYS>
      <INDEXES>
        <INDEX NAME="assignment_idx" UNIQUE="false" FIELDS="assignment" COMMENT="Index on assignment for faster queries" />
        <INDEX NAME="submission_idx" UNIQUE="true" FIELDS="submission" COMMENT="Index on submission for direct lookups" />
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
